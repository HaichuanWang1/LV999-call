# ============================================================
# Live2D 第三方资源（不入库 / 不随仓库分发）
# ============================================================
# 原因：模型美术与 Live2D Cubism Core 的版权均不归本项目所有，
# 公开仓库分发存在法律风险。请用 tools/setup_live2d_assets.sh
# 在本地拉取，或放入自备模型。缺失时 App 会自动回退静态头像。
/app/src/main/assets/live2d/lib/
/app/src/main/assets/live2d/models/

# 自备/私有模型（防止误提交）
# 放到上述 models/ 目录即可，已被整目录忽略

# 第三方模型的原始下载包（解包后放入 assets/live2d/models/ 使用）
# 内容与已解包的模型重复，同样属于上面那批不入库的第三方美术资源
_tmp_ds/

# Python 工具的运行产物（tools/ 下有 .py 脚本）
__pycache__/
*.pyc

# 迁移校验脚本的运行产物（tools/memory_migration_check.py 会建一个临时库）
tools/migration_check/

# Agent 工作流中间产物（阶段规格/审查提词，随会话生成，不属于项目源码）
.dsh/

# Archify 出图的中间产物（候选 JSON / 浏览器证据 / 截图，可随时重跑）
.archify/

# ============================================================
# Archify Skill 自带的示例「渲染产物」（不入库）
# ============================================================
# 这些 HTML 是 examples/*.json 渲染出来的成品，不是源码：
# 5 个文件合计 3.7MB，占了仓库 HTML 体积的绝大部分，
# 会把 GitHub 的语言统计顶成「HTML 主导」。
# 示例的源（*.json）已入库，需要时一条命令重新渲染：
#   node .agents/skills/archify/scripts/render-examples.mjs
.agents/skills/archify/examples/*.html
