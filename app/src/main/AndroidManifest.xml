<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      麦克风权限（运行时权限，API 23+ 必须在使用前申请）。
      ⚠️ 声明只是"允许申请"，真正弹系统对话框的是
      `ui/common/PermissionGate.kt` 的 MicPermissionGuard —— 它挂在三条通话路由
      （内置角色 / 自定义预设 / 续聊）的入口上，进通话页即申请。
      以前只有 AudioRecorder 里一句 checkSelfPermission（从不 request），
      新装用户进通话页会得到一个"她听不到你"的静默坏功能。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      记忆提醒通知（API 33+ 才存在这条权限，低版本声明了也不会要求授予）。
      ⚠️ 只声明是不够的：推送前必须在 ReminderNotifier 里检查权限与通知总开关，
      设置页也要在用户打开开关时用 RequestPermission 发起请求 —— 否则开关能打开、
      通知却永远弹不出来（Android 13 的静默失败，排查起来只能靠日志）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      存储权限：**故意不声明**。
      头像 / 背景图 / 参考音频全部走 SAF（`ActivityResultContracts.GetContent()`），
      记忆库导出走 `CreateDocument()` —— 这两条路都由系统按次授权单个 Uri，
      根本不需要 READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE。声明了不用，
      只会在应用详情页里多出一堆用户看不懂、也不会被请求的权限条目。
    -->

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UltraFlow"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UltraFlow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
