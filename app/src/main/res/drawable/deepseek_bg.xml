<?xml version="1.0" encoding="utf-8"?>
<!--
  DeepSeek 酱通话/准备页背景。

  刻意不做成图片：银狼用的是作者提供的实拍背景图（silverwolf_bg.jpg），
  而 DS鲸鱼娘 的模型包只带角色立绘，没有配套背景；随手配一张网图既有版权
  风险又和角色色调打架。这里直接用 DeepSeek 官方主色 #4D6BFE 做一层
  深浅渐变，配合通话页本来就有的模糊 + 渐变遮罩，观感是"深海"而不是空背景。

  ⚠️ 必须是 <vector>，不能写成 <shape>：
  Compose 的 painterResource 只支持 VectorDrawable 与位图
  （PNG/JPG/WEBP），遇到 <shape>/<selector> 这类会直接抛
  IllegalArgumentException（"Only VectorDrawables and rasterized asset types
  are supported"）。本文件最初写成 <shape>，导致点击 DeepSeek 酱进入准备页
  立刻闪退 —— 银狼那档用的是 .jpg 位图，所以只有这个角色会崩。
  渐变用 aapt:attr 内联（API 24+ 支持，本项目 minSdk 26）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="640dp"
    android:viewportWidth="360"
    android:viewportHeight="640">
    <path android:pathData="M0,0h360v640h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="180"
                android:startY="0"
                android:endX="180"
                android:endY="640"
                android:startColor="#FF0B1030"
                android:centerColor="#FF16265C"
                android:endColor="#FF2E4BA8" />
        </aapt:attr>
    </path>
</vector>
